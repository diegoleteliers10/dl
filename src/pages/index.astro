---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Hero from "../components/Hero.astro";
import About from "../components/About.astro";
import Projects from "../components/Projects.astro";
import Experience from "../components/Experience.astro";
import Contact from "../components/Contact.astro";
import Footer from "../components/Footer.astro";
import { ui, type Lang } from "../i18n/ui";

const lang: Lang = "en";
const t = ui[lang];
---

<Base lang={lang} title={t.meta.title} description={t.meta.description}>
  <Nav lang={lang} labels={t.nav} />
  <Hero
    name={t.hero.name}
    sub={t.hero.sub}
    boot={t.hero.boot}
    terminalTitle={t.hero.terminalTitle}
    ctaProjects={t.hero.ctaProjects}
    ctaCv={t.hero.ctaCv}
    promptHint={t.hero.promptHint}
    shell={t.hero.shell}
  />
  <About
    title={t.about.title}
    paragraphs={t.about.paragraphs}
    fullName={t.about.fullName}
    location={t.about.location}
    stats={t.about.stats}
    stackTitle={t.about.stackTitle}
    stack={t.about.stack}
  />
  <Projects
    title={t.projects.title}
    viewSource={t.projects.viewSource}
    liveDemo={t.projects.liveDemo}
    items={t.projects.items}
  />
  <Experience
    title={t.experience.title}
    education={t.experience.education}
    entries={t.experience.entries}
    educationEntries={t.experience.educationEntries}
  />
  <Contact
    title={t.contact.title}
    sub={t.contact.sub}
    cta={t.contact.cta}
    github={t.contact.github}
    linkedin={t.contact.linkedin}
    cv={t.contact.cv}
  />
  <Footer copyright={t.footer.copyright} location={t.footer.location} />
</Base>
