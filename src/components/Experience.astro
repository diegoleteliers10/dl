---
interface Entry {
  role: string;
  org: string;
  period: string;
  description?: string;
}

interface Props {
  title: string;
  education: string;
  entries: Entry[];
  educationEntries: Entry[];
}

const { title, education, entries, educationEntries } = Astro.props;
---

<section id="experience" class="scroll-mt-24 border-t border-zinc-800/60 py-28">
  <div class="mx-auto max-w-6xl px-6">
    <h2 class="font-mono text-3xl font-semibold tracking-tight text-zinc-50" data-reveal>
      {title}
    </h2>

    <div class="mt-12 max-w-4xl" data-reveal>
      {
        entries.map((entry) => (
          <div class="grid gap-2 border-b border-zinc-800/50 py-6 sm:grid-cols-12 sm:gap-6">
            <p class="font-mono text-xs text-zinc-500 sm:col-span-3 sm:pt-1">{entry.period}</p>
            <div class="sm:col-span-9">
              <h3 class="text-zinc-100">
                <span class="font-medium">{entry.role}</span>
                <span class="text-zinc-500"> / </span>
                <span class="font-mono text-sm text-accent">{entry.org}</span>
              </h3>
              {entry.description && (
                <p class="mt-2 max-w-[65ch] text-sm leading-relaxed text-zinc-400">
                  {entry.description}
                </p>
              )}
            </div>
          </div>
        ))
      }
    </div>

    <div class="mt-16 max-w-4xl" data-reveal>
      <h3 class="font-mono text-sm text-zinc-500">{education}</h3>
      <div class="mt-4">
        {
          educationEntries.map((entry) => (
            <div class="grid gap-2 py-3 sm:grid-cols-12 sm:gap-6">
              <p class="font-mono text-xs text-zinc-500 sm:col-span-3 sm:pt-1">{entry.period}</p>
              <p class="sm:col-span-9">
                <span class="text-sm text-zinc-200">{entry.role}</span>
                <span class="text-zinc-600"> / </span>
                <span class="font-mono text-sm text-accent">{entry.org}</span>
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
