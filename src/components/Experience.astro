---
import SchoolLogo from "./SchoolLogo.astro";
import CompanyMark from "./CompanyMark.astro";
import udd from "../assets/schools/udd.svg";
import soyhenry from "../assets/schools/soyhenry.svg";
import cvd from "../assets/schools/cvd.png";
import bearclaw from "../assets/companies/bearclaw.png";
import indiesla from "../assets/companies/indiesla.png";
import tigo from "../assets/companies/tigo.png";
import type { ImageMetadata } from "astro";

interface Entry {
  role: string;
  org: string;
  period: string;
  description?: string;
  flag?: string;
  logo?: string;
  logoAlt?: string;
}

interface Props {
  title: string;
  education: string;
  entries: Entry[];
  educationEntries: Entry[];
}

const { title, education, entries, educationEntries } = Astro.props;

const schoolArt: Record<string, ImageMetadata> = { udd, soyhenry, cvd };
const companyArt: Record<string, ImageMetadata> = { bearclaw, indiesla, tigo };
---

<section id="experience" class="scroll-mt-24 border-t border-zinc-800/60 py-28">
  <div class="mx-auto max-w-6xl px-6">
    <h2
      class="section-title font-mono text-3xl font-semibold tracking-tight text-zinc-50"
      data-reveal
    >
      {title}
    </h2>

    <div class="mt-12" data-reveal>
      {
        entries.map((entry) => {
          const art = entry.logo ? companyArt[entry.logo] : undefined;
          return (
            <div class="row-hover grid grid-cols-12 items-start gap-x-6 gap-y-2 border-b border-zinc-800/50 py-6 transition-colors duration-150">
              <p class="col-span-12 font-mono text-xs text-zinc-500 sm:col-span-3 sm:pt-1">
                {entry.flag && <span class="mr-1.5">{entry.flag}</span>}
                {entry.period}
              </p>
              <div class="col-span-9 sm:col-span-6">
                <h3 class="text-zinc-100">
                  <span class="font-medium">{entry.role}</span>
                  <span class="text-zinc-500"> / </span>
                  <span class="font-mono text-sm text-accent">{entry.org}</span>
                </h3>
                {entry.description && (
                  <p class="mt-2 max-w-[65ch] text-sm leading-relaxed text-zinc-400">
                    {entry.description}
                  </p>
                )}
              </div>
              {art && (
                <div class="col-span-3 flex justify-end">
                  <CompanyMark src={art} alt={entry.logoAlt ?? entry.org} />
                </div>
              )}
            </div>
          );
        })
      }
    </div>

    <div class="mt-16" data-reveal>
      <h3 class="font-mono text-sm text-zinc-500">{education}</h3>
      <div class="mt-4 max-w-4xl">
        {
          educationEntries.map((entry) => {
            const art = entry.logo ? schoolArt[entry.logo] : undefined;
            return (
              <div class="row-hover grid grid-cols-12 items-center gap-6 border-b border-zinc-800/50 py-5 transition-colors duration-150">
                <p class="col-span-12 font-mono text-xs text-zinc-500 sm:col-span-3">
                  {entry.period}
                </p>
                <p class="col-span-9 sm:col-span-6">
                  <span class="text-sm text-zinc-200">{entry.role}</span>
                  <span class="text-zinc-600"> / </span>
                  <span class="font-mono text-sm text-accent">{entry.org}</span>
                </p>
                {art && (
                  <div class="col-span-3 flex justify-end">
                    <SchoolLogo src={art} alt={entry.logoAlt ?? entry.org} />
                  </div>
                )}
              </div>
            );
          })
        }
      </div>
    </div>
  </div>
</section>
