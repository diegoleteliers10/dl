---
import FileArrowDown from "@phosphor-icons/core/assets/regular/file-arrow-down.svg?raw";
import ArrowDown from "@phosphor-icons/core/assets/regular/arrow-down.svg?raw";

interface ShellStrings {
  help: string;
  helpTip: string;
  whoami: string;
  ls: string;
  jump: string;
  sudo: string;
  notFound: string;
}

interface Props {
  name: string;
  sub: string;
  boot: { cmd: string; out: string }[];
  terminalTitle: string;
  ctaProjects: string;
  ctaCv: string;
  promptHint: string;
  shell: ShellStrings;
}

const { name, sub, boot, terminalTitle, ctaProjects, ctaCv, promptHint, shell } = Astro.props;
---

<section class="flex min-h-[100dvh] items-center pt-16 pb-16">
  <div class="mx-auto grid w-full max-w-6xl items-center gap-12 px-6 lg:grid-cols-12 lg:gap-10">
    <div id="hero-body" class="hero-body lg:col-span-7">
      <h1 class="font-mono text-5xl font-semibold tracking-tighter text-zinc-50 sm:text-7xl">
        {name}
      </h1>
      <p class="mt-6 max-w-[60ch] text-lg leading-relaxed text-zinc-400">{sub}</p>
      <div class="mt-10 flex flex-wrap items-center gap-4">
        <a href="#projects" class="btn-primary inline-flex items-center gap-2 bg-accent px-5 py-3 font-mono text-sm font-medium text-zinc-950">
          <span class="icon" set:html={ArrowDown} />
          {ctaProjects}
        </a>
        <a
          href="/CV_Diego_Letelie_ES.pdf"
          class="inline-flex items-center gap-2 border border-zinc-700 px-5 py-3 font-mono text-sm text-zinc-200 transition-[color,border-color,transform] duration-150 ease-out hover:border-accent hover:text-accent active:scale-[0.98]"
        >
          <span class="icon" set:html={FileArrowDown} />
          {ctaCv}
        </a>
      </div>
    </div>

    <div class="lg:col-span-5">
      <div id="terminal" class="w-full border border-zinc-800 bg-zinc-900/40">
        <div class="flex items-center gap-1.5 border-b border-zinc-800 px-4 py-2">
          <span class="h-2 w-2 rounded-full bg-zinc-700" aria-hidden="true"></span>
          <span class="h-2 w-2 rounded-full bg-zinc-700" aria-hidden="true"></span>
          <span class="h-2 w-2 rounded-full bg-zinc-700" aria-hidden="true"></span>
          <p class="ml-2 font-mono text-xs text-zinc-500">{terminalTitle}</p>
        </div>
        <div id="t-body" class="cursor-text px-4 py-4 font-mono text-sm leading-relaxed">
          {
            boot.map((line) => (
              <div data-group hidden>
                <div>
                  <span class="text-accent">$</span> <span data-cmd>{line.cmd}</span>
                </div>
                <div data-out hidden class={line.cmd === 'cat focus.txt' ? 'text-accent' : 'text-zinc-100'}>
                  {line.out}
                </div>
              </div>
            ))
          }
          <div id="t-history"></div>
          <div id="t-input" hidden>
            <span class="text-accent">$</span> <span id="t-cmd"></span><span class="t-cursor">▌</span>
          </div>
        </div>
        <input
          id="t-hidden"
          type="text"
          autocomplete="off"
          autocapitalize="off"
          spellcheck="false"
          aria-label="Terminal input"
          class="absolute h-px w-px opacity-0"
        />
      </div>
      <p class="mt-3 font-mono text-xs text-zinc-500">{promptHint}</p>
    </div>
  </div>
</section>

<script is:inline type="application/json" id="t-i18n" set:html={JSON.stringify(shell)} />

<script>
  const groups = Array.from(
    document.querySelectorAll<HTMLElement>("[data-group]"),
  );
  const inputLine = document.getElementById("t-input")!;
  const heroBody = document.getElementById("hero-body")!;
  const hiddenInput = document.getElementById("t-hidden") as HTMLInputElement;
  const cmdSpan = document.getElementById("t-cmd")!;
  const history = document.getElementById("t-history")!;
  const terminalBody = document.getElementById("t-body")!;
  const terminal = document.getElementById("terminal")!;
  const shell = JSON.parse(document.getElementById("t-i18n")!.textContent!);

  const email = "dleteliersr@gmail.com";

  function format(tpl: string, values: Record<string, string>): string {
    return tpl.replace(/\{(\w+)\}/g, (_, key: string) => values[key] ?? "");
  }

  function emit(node: HTMLElement): void {
    node.classList.add("t-line");
    history.appendChild(node);
  }

  function echo(cmd: string): void {
    const line = document.createElement("div");
    const prompt = document.createElement("span");
    prompt.className = "text-accent";
    prompt.textContent = "$";
    line.append(prompt, " " + cmd);
    emit(line);
  }

  function respond(text: string): void {
    const line = document.createElement("div");
    line.className = "text-zinc-400";
    line.textContent = text;
    emit(line);
  }

  function scrollTo(id: string): void {
    document.getElementById(id)?.scrollIntoView({ behavior: "smooth" });
  }

  function run(cmdRaw: string): void {
    const cmd = cmdRaw.trim().toLowerCase();
    if (!cmd) return;
    echo(cmd);
    if (cmd === "clear") {
      history.replaceChildren();
    } else if (cmd === "help") {
      respond(shell.help);
      respond(shell.helpTip);
    } else if (cmd === "whoami") {
      respond(shell.whoami);
    } else if (cmd === "ls") {
      respond(shell.ls);
    } else if (cmd === "projects" || cmd === "about" || cmd === "contact" || cmd === "experience") {
      respond(format(shell.jump, { to: cmd }));
      scrollTo(cmd);
    } else if (cmd === "sudo hire-me" || cmd === "sudo hire me") {
      respond(shell.sudo);
      window.location.href = `mailto:${email}`;
    } else {
      respond(format(shell.notFound, { cmd }));
    }
  }

  hiddenInput.addEventListener("input", () => {
    cmdSpan.textContent = hiddenInput.value;
  });

  hiddenInput.addEventListener("keydown", (event) => {
    if (event.key === "Enter") {
      run(hiddenInput.value);
      hiddenInput.value = "";
      cmdSpan.textContent = "";
    }
  });

  terminalBody.addEventListener("click", () => hiddenInput.focus());

  terminal.addEventListener(
    "focusin",
    () => terminal.classList.add("is-focused"),
    { once: true },
  );
  terminal.addEventListener("focusout", () => terminal.classList.remove("is-focused"));

  function finishBoot(): void {
    inputLine.hidden = false;
    heroBody.classList.add("is-in");
  }

  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (reduce) {
    groups.forEach((group) => {
      group.hidden = false;
      group.querySelector("[data-out]")?.removeAttribute("hidden");
    });
    finishBoot();
  } else {
    let index = 0;
    function typeGroup(): void {
      if (index >= groups.length) {
        finishBoot();
        return;
      }
      const group = groups[index]!;
      const cmdEl = group.querySelector("[data-cmd]")!;
      const text = cmdEl.textContent ?? "";
      cmdEl.textContent = "";
      group.hidden = false;
      let i = 0;
      const tick = (): void => {
        if (i <= text.length) {
          cmdEl.textContent = text.slice(0, i);
          i += 1;
          window.setTimeout(tick, 22 + Math.random() * 28);
        } else {
          window.setTimeout(() => {
            group.querySelector("[data-out]")?.removeAttribute("hidden");
            index += 1;
            window.setTimeout(typeGroup, 180);
          }, 160);
        }
      };
      tick();
    }
    typeGroup();
  }
</script>
