---
import { Picture } from "astro:assets";
import GithubLogo from "@phosphor-icons/core/assets/regular/github-logo.svg?raw";
import ArrowUpRight from "@phosphor-icons/core/assets/regular/arrow-up-right.svg?raw";
import Globe from "@phosphor-icons/core/assets/regular/globe.svg?raw";
import biovityShot from "../assets/projects/biovity.png";
import fastyShot from "../assets/projects/fasty.png";
import corvoShot from "../assets/projects/corvo.png";
import type { ImageMetadata } from "astro";

interface Project {
  id: string;
  name: string;
  meta: string;
  description: string;
  file?: string;
  demo?: string;
  link: string;
}

interface Props {
  title: string;
  viewSource: string;
  liveDemo: string;
  items: Project[];
}

const { title, viewSource, liveDemo, items } = Astro.props;

const shots: Record<string, ImageMetadata> = {
  biovity: biovityShot,
  fasty: fastyShot,
  corvo: corvoShot,
};

const biovity = items.find((p) => p.id === "biovity")!;
const fasty = items.find((p) => p.id === "fasty")!;
const corvo = items.find((p) => p.id === "corvo")!;
const portmanager = items.find((p) => p.id === "portmanager")!;
const churn = items.find((p) => p.id === "churn")!;
---

<section id="projects" class="scroll-mt-24 border-t border-zinc-800/60 py-28">
  <div class="mx-auto max-w-6xl px-6">
    <h2
      class="section-title font-mono text-3xl font-semibold tracking-tight text-zinc-50"
      data-reveal
    >
      {title}
    </h2>

    <article class="mt-16 grid items-center gap-10 lg:grid-cols-12">
      <div class="lg:col-span-5" data-reveal>
        <h3 class="font-mono text-2xl font-semibold tracking-tight text-zinc-50">
          {biovity.name}
        </h3>
        <p class="mt-2 font-mono text-xs text-zinc-500">{biovity.meta}</p>
        <p class="mt-5 max-w-[55ch] leading-relaxed text-zinc-400">{biovity.description}</p>
        <div class="mt-6 flex flex-wrap items-center gap-6">
          <a
            href={biovity.demo}
            target="_blank"
            rel="noopener noreferrer"
            class="link-live inline-flex items-center gap-2 font-mono text-sm text-accent transition-colors duration-150"
          >
            <span class="icon" set:html={Globe} />
            {liveDemo}
            <span class="icon" set:html={ArrowUpRight} />
          </a>
          <a
            href={biovity.link}
            target="_blank"
            rel="noopener noreferrer"
            class="sweep inline-flex items-center gap-2 font-mono text-sm text-zinc-300 transition-colors duration-150 hover:text-accent"
          >
            <span class="icon" set:html={GithubLogo} />
            {viewSource}
          </a>
        </div>
      </div>
      <div class="lg:col-span-7" data-reveal style="--reveal-delay: 120ms">
        <div class="lift shot-frame border border-zinc-800 bg-zinc-900/40">
          <div class="flex items-center gap-2 border-b border-zinc-800 px-4 py-2">
            <span class="h-1.5 w-1.5 rounded-full bg-accent/70" aria-hidden="true"></span>
            <p class="font-mono text-xs text-zinc-500">{biovity.file}</p>
          </div>
          <div class="overflow-hidden">
            <Picture
              src={shots.biovity!}
              alt={`${biovity.name} landing page`}
              widths={[560, 900, 1400]}
              sizes="(min-width: 1024px) 40rem, 100vw"
              formats={["avif", "webp"]}
              fallbackFormat="webp"
              loading="lazy"
              decoding="async"
              class="shot-img h-auto w-full"
            />
          </div>
        </div>
      </div>
    </article>

    <article class="mt-24 grid items-center gap-10 lg:grid-cols-12">
      <div class="order-2 lg:order-1 lg:col-span-7" data-reveal>
        <div class="lift shot-frame border border-zinc-800 bg-zinc-900/40">
          <div class="flex items-center gap-2 border-b border-zinc-800 px-4 py-2">
            <span class="h-1.5 w-1.5 rounded-full bg-accent/70" aria-hidden="true"></span>
            <p class="font-mono text-xs text-zinc-500">{fasty.file}</p>
          </div>
          <div class="overflow-hidden">
            <Picture
              src={shots.fasty!}
              alt={`${fasty.name} website`}
              widths={[560, 900, 1400]}
              sizes="(min-width: 1024px) 40rem, 100vw"
              formats={["avif", "webp"]}
              fallbackFormat="webp"
              loading="lazy"
              decoding="async"
              class="shot-img h-auto w-full"
            />
          </div>
        </div>
      </div>
      <div class="order-1 lg:order-2 lg:col-span-5" data-reveal style="--reveal-delay: 120ms">
        <h3 class="font-mono text-2xl font-semibold tracking-tight text-zinc-50">{fasty.name}</h3>
        <p class="mt-2 font-mono text-xs text-zinc-500">{fasty.meta}</p>
        <p class="mt-5 max-w-[55ch] leading-relaxed text-zinc-400">{fasty.description}</p>
        <div class="mt-6 flex flex-wrap items-center gap-6">
          <a
            href={fasty.demo}
            target="_blank"
            rel="noopener noreferrer"
            class="link-live inline-flex items-center gap-2 font-mono text-sm text-accent transition-colors duration-150"
          >
            <span class="icon" set:html={Globe} />
            {liveDemo}
            <span class="icon" set:html={ArrowUpRight} />
          </a>
          <a
            href={fasty.link}
            target="_blank"
            rel="noopener noreferrer"
            class="sweep inline-flex items-center gap-2 font-mono text-sm text-zinc-300 transition-colors duration-150 hover:text-accent"
          >
            <span class="icon" set:html={GithubLogo} />
            {viewSource}
          </a>
        </div>
      </div>
    </article>

    <article class="mt-24 grid items-center gap-10 lg:grid-cols-12">
      <div class="lg:col-span-5" data-reveal>
        <h3 class="font-mono text-2xl font-semibold tracking-tight text-zinc-50">{corvo.name}</h3>
        <p class="mt-2 font-mono text-xs text-zinc-500">{corvo.meta}</p>
        <p class="mt-5 max-w-[55ch] leading-relaxed text-zinc-400">{corvo.description}</p>
        <div class="mt-6 flex flex-wrap items-center gap-6">
          <a
            href={corvo.demo}
            target="_blank"
            rel="noopener noreferrer"
            class="link-live inline-flex items-center gap-2 font-mono text-sm text-accent transition-colors duration-150"
          >
            <span class="icon" set:html={Globe} />
            {liveDemo}
            <span class="icon" set:html={ArrowUpRight} />
          </a>
          <a
            href={corvo.link}
            target="_blank"
            rel="noopener noreferrer"
            class="sweep inline-flex items-center gap-2 font-mono text-sm text-zinc-300 transition-colors duration-150 hover:text-accent"
          >
            <span class="icon" set:html={GithubLogo} />
            {viewSource}
          </a>
        </div>
      </div>
      <div class="lg:col-span-7" data-reveal style="--reveal-delay: 120ms">
        <div class="lift shot-frame border border-zinc-800 bg-zinc-900/40">
          <div class="flex items-center gap-2 border-b border-zinc-800 px-4 py-2">
            <span class="h-1.5 w-1.5 rounded-full bg-accent/70" aria-hidden="true"></span>
            <p class="font-mono text-xs text-zinc-500">{corvo.file}</p>
          </div>
          <div class="overflow-hidden">
            <Picture
              src={shots.corvo!}
              alt={`${corvo.name} website`}
              widths={[560, 900, 1400]}
              sizes="(min-width: 1024px) 40rem, 100vw"
              formats={["avif", "webp"]}
              fallbackFormat="webp"
              loading="lazy"
              decoding="async"
              class="shot-img h-auto w-full"
            />
          </div>
        </div>
      </div>
    </article>

    <div class="mt-24 grid gap-6 md:grid-cols-5">
      <article
        class="lift border border-zinc-800 p-6 md:col-span-3"
        data-reveal
      >
        <h3 class="font-mono text-lg font-semibold tracking-tight text-zinc-50">
          {portmanager.name}
        </h3>
        <p class="mt-2 font-mono text-xs text-zinc-500">{portmanager.meta}</p>
        <p class="mt-4 leading-relaxed text-zinc-400">{portmanager.description}</p>
        <a
          href={portmanager.link}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-5 inline-flex items-center gap-2 font-mono text-sm text-zinc-300 transition-colors duration-150 hover:text-accent"
        >
          <span class="icon" set:html={GithubLogo} />
          {viewSource}
          <span class="icon" set:html={ArrowUpRight} />
        </a>
      </article>
      <article
        class="lift border border-zinc-800 p-6 md:col-span-2"
        data-reveal
        style="--reveal-delay: 100ms"
      >
        <h3 class="font-mono text-lg font-semibold tracking-tight text-zinc-50">{churn.name}</h3>
        <p class="mt-2 font-mono text-xs text-zinc-500">{churn.meta}</p>
        <p class="mt-4 leading-relaxed text-zinc-400">{churn.description}</p>
        <a
          href={churn.link}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-5 inline-flex items-center gap-2 font-mono text-sm text-zinc-300 transition-colors duration-150 hover:text-accent"
        >
          <span class="icon" set:html={GithubLogo} />
          {viewSource}
          <span class="icon" set:html={ArrowUpRight} />
        </a>
      </article>
    </div>
  </div>
</section>

<style>
  .link-live::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: -0.15em;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: right center;
    transition: transform var(--dur-ui) var(--ease-in-out-quart);
  }

  .link-live {
    position: relative;
  }

  @media (hover: hover) and (pointer: fine) {
    .link-live:hover::after {
      transform: scaleX(1);
      transform-origin: left center;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .link-live::after {
      transition: none;
    }
  }
</style>
