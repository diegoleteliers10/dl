---
import { langPath, type Lang } from "../i18n/ui";

interface Props {
  lang: Lang;
  labels: { about: string; projects: string; experience: string; contact: string };
}

const { lang, labels } = Astro.props;
const other: Lang = lang === "en" ? "es" : "en";
---

<header class="fixed inset-x-0 top-0 z-50 border-b border-zinc-800/60 bg-zinc-950/80 backdrop-blur">
  <nav class="mx-auto flex h-16 max-w-6xl items-center justify-between px-6" aria-label="Main">
    <a href={langPath[lang]} class="font-mono text-sm text-zinc-100 hover:text-accent">
      ~/diego<span class="text-accent">_$</span>
    </a>
    <div class="flex items-center gap-6">
      <ul class="hidden items-center gap-6 md:flex">
        <li>
          <a href="#about" class="font-mono text-sm text-zinc-400 hover:text-accent">{labels.about}</a>
        </li>
        <li>
          <a href="#projects" class="font-mono text-sm text-zinc-400 hover:text-accent">{labels.projects}</a>
        </li>
        <li>
          <a href="#experience" class="font-mono text-sm text-zinc-400 hover:text-accent">{labels.experience}</a>
        </li>
        <li>
          <a href="#contact" class="font-mono text-sm text-zinc-400 hover:text-accent">{labels.contact}</a>
        </li>
      </ul>
      <div class="flex items-center gap-2 font-mono text-sm">
        {
          lang === "en" ? (
            <span class="text-accent" aria-current="true">EN</span>
          ) : (
            <a href="/" class="text-zinc-500 hover:text-accent">EN</a>
          )
        }
        <span class="text-zinc-700">/</span>
        {
          lang === "es" ? (
            <span class="text-accent" aria-current="true">ES</span>
          ) : (
            <a href="/es/" class="text-zinc-500 hover:text-accent">ES</a>
          )
        }
      </div>
    </div>
  </nav>
</header>
