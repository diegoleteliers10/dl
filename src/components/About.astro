---
interface Props {
  title: string;
  paragraphs: string[];
  fullName: string;
  location: string;
  stats: { value: string; label: string }[];
  stackTitle: string;
  stack: { group: string; items: string[] }[];
}

const { title, paragraphs, fullName, location, stats, stackTitle, stack } = Astro.props;
---

<section id="about" class="scroll-mt-24 border-t border-zinc-800/60 py-28">
  <div class="mx-auto max-w-6xl px-6">
    <div class="grid gap-14 lg:grid-cols-12">
      <div class="lg:col-span-7" data-reveal>
        <h2 class="font-mono text-3xl font-semibold tracking-tight text-zinc-50">{title}</h2>
        <div class="mt-8 space-y-5">
          {
            paragraphs.map((p) => (
              <p class="max-w-[65ch] leading-relaxed text-zinc-400">{p}</p>
            ))
          }
        </div>
        <div class="mt-10 flex items-start gap-4">
          <img
            src="https://github.com/diegoleteliers10.png"
            alt={fullName}
            width="128"
            height="128"
            loading="lazy"
            class="h-32 w-32 border border-zinc-800 object-cover grayscale"
          />
          <div>
            <p class="font-mono text-sm text-zinc-200">{fullName}</p>
            <p class="font-mono text-xs text-zinc-500">{location}</p>
          </div>
        </div>
      </div>

      <div class="lg:col-span-5" data-reveal style="--reveal-delay: 120ms">
        <dl class="grid grid-cols-2 gap-x-6 gap-y-8">
          {
            stats.map((stat) => (
              <div>
                <dt class="font-mono text-xs text-zinc-500">{stat.label}</dt>
                <dd class="font-mono text-3xl font-semibold tracking-tight text-green-400">
                  {stat.value}
                </dd>
              </div>
            ))
          }
        </dl>

        <h3 class="mt-12 font-mono text-xs uppercase tracking-widest text-zinc-500">{stackTitle}</h3>
        <div class="mt-5 space-y-5">
          {
            stack.map((group) => (
              <div>
                <p class="font-mono text-xs text-zinc-500">{group.group}</p>
                <ul class="mt-2 flex flex-wrap gap-2">
                  {group.items.map((item) => (
                    <li class="border border-zinc-800 px-2 py-1 font-mono text-xs text-zinc-300">
                      {item}
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>
